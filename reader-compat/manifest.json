{
  "manifest_version": 2,
  "name": "PaperBridge Reader Compatibility",
  "version": "0.1.0",
  "description": "独立的 Codex for Zotero 阅读选区兼容层，保留 HTML/PDF 选区并在侧栏更新后重新挂接。",
  "applications": {
    "zotero": {
      "id": "reader-compat@paperbridge.local",
      "update_url": "https://paperbridge.invalid/reader-compat-updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
